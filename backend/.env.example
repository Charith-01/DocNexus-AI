APP_NAME=DocNexus AI
APP_ENV=development
DEBUG=true

MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=docnexus

JWT_SECRET_KEY=CHANGE_ME
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

MAX_UPLOAD_SIZE_MB=20
FRONTEND_ORIGIN=http://localhost:5173

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHROMA_PERSIST_DIR=../storage/chroma
CHROMA_COLLECTION_NAME=docnexus_chunks
RETRIEVAL_CHUNK_SIZE=500
RETRIEVAL_CHUNK_OVERLAP=100
RETRIEVAL_TOP_K=5
HYBRID_SEMANTIC_WEIGHT=0.6
HYBRID_BM25_WEIGHT=0.4
